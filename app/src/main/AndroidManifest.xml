<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether a VPN (Tailscale) is up, and wifi or cell for the laptop's dashboard page -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The laptop's sound: raise a zeroed media volume, pin it to the speaker -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- In-app updates from GitHub Releases: install them, say a new one is ready -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- "Tailscale is off": the button that opens it -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <!-- The code scanner comes with Google Play services: fetch it when Weave is installed, not on the first scan -->
    <application
        android:name=".WeaveApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Weave">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- Shares downloaded update APKs with the system package installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- PackageInstaller commit trampoline (an activity avoids OEM broadcast and background limits) -->
        <activity
            android:name=".data.update.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:finishOnTaskLaunch="true" />

        <!-- Fallback open prompt if the relaunch after an update is blocked -->
        <receiver
            android:name=".data.update.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shortcuts on the home screen: a tap runs one without opening Weave -->
        <receiver
            android:name=".widget.ShortcutsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_shortcuts_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shortcuts_widget_info" />
        </receiver>

        <!-- The home screen added the widget asked for from Weave: its shortcuts go on it -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />

        <!-- Which shortcuts a widget shows; the home screen opens it when one is added or edited -->
        <activity
            android:name=".widget.ShortcutsWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A computer's pairing link: weave://pair?..., which the pairing page hands over -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="weave" android:host="pair" />
            </intent-filter>
        </activity>
    </application>
</manifest>
